{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
  // this keeps the pins (and their comments) up to date.
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  dependencyDashboard: true,
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  prConcurrentLimit: 10,
  // Non-major updates automerge (rule below). Without a delay, a compromised
  // upstream release would be merged as soon as CI passes: an action that
  // release.yml runs, or a Python package or pre-commit hook that runs in the
  // job building the distribution. This holds every update until its release
  // is 3 days old; automerge still applies after that.
  //
  // `timestamp-required` (the default since Renovate 42, set explicitly
  // here) keeps an update without a release timestamp pending instead of
  // letting it through immediately. `strict` (also the default) creates no
  // branch until the age check passes. Pending updates are listed on the
  // Dependency Dashboard, where they can be forced.
  //
  // Limitation: for GitHub tags the timestamp is the committedDate of the
  // tagged commit, set by whoever made the commit, and a force-pushed tag is
  // aged against the original date. So this is a delay for ordinary
  // releases, not a guarantee against a determined attacker.
  minimumReleaseAge: "3 days",
  minimumReleaseAgeBehaviour: "timestamp-required",
  internalChecksFilter: "strict",
  // A fix for a known vulnerability is not held back (Renovate's default,
  // stated here so the delay above is not read as covering it).
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  "pre-commit": {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
    // uv does not enforce the age itself, so with the top-level delay the
    // weekly lock file branch would stay pending forever.
    minimumReleaseAge: null,
  },
  // Tools a workflow or the Read the Docs config installs on a command line,
  // and the uv that setup-uv installs (its `version:` input). No manager sees
  // those, so each is pinned under a `# renovate:` comment naming where it
  // comes from, and this keeps the pin moving.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.readthedocs\\.yaml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[^\\n]*?(?:@|==|version: \")(?<currentValue>[0-9][^\\s\"'\\]]*)",
      ],
    },
  ],
  packageRules: [
    {
      description: "Group all GitHub Actions updates into a single PR",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      description: "Group all pre-commit hook updates into a single PR",
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
    },
    {
      description: "Group all Python dependency updates into a single PR",
      matchManagers: ["pep621"],
      groupName: "python dependencies",
    },
    // A tool pinned both as a pre-commit hook and in uv.lock must move in
    // one PR. CI lints with the locked version and contributors run the hook,
    // so when only one side moved (#453), pre-commit failed on master while CI
    // stayed green. These rules come after the manager groups above, so their
    // groupName wins. `bump` raises the pyproject floor to the new version,
    // which makes the PR relock to it too.
    {
      description: "Keep the ruff pre-commit hook and the locked ruff in step",
      matchPackageNames: ["ruff", "astral-sh/ruff-pre-commit"],
      groupName: "ruff",
      rangeStrategy: "bump",
    },
    {
      description: "Keep the uv pre-commit hook (uv lock) and the uv_build backend in step",
      matchPackageNames: ["uv_build", "astral-sh/uv-pre-commit"],
      groupName: "uv",
    },
    {
      // Renovate itself releases several times a day; one pull request a
      // week for these pins is enough.
      description: "Group the tools pinned on a command line (customManagers)",
      matchManagers: ["custom.regex"],
      groupName: "command-line tools",
      schedule: ["before 6am on monday"],
    },
    {
      description: "Automerge non-major updates once CI passes",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      description: "Major updates always require manual review",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major-update"],
    },
    {
      // The typos hook installs `typos==<rev>` from PyPI, and the v1.52.1
      // wheels never reached PyPI (the upstream publish job failed), so that
      // rev breaks every pre-commit run. Drop this rule once a newer release
      // is out.
      description: "Skip typos v1.52.1: it was never published to PyPI",
      matchDepNames: ["crate-ci/typos"],
      allowedVersions: "!/^v1\\.52\\.1$/",
    },
    {
      description: "lowest.yml pins the oldest supported Python on purpose",
      matchFileNames: [".github/workflows/lowest.yml"],
      matchDepNames: ["python"],
      enabled: false,
    },
  ],
}
